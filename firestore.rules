rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'kbK0s79KHZbzp8XMPnrfSjwTxw53';
    }
    match /paymentRequests/{id} {
      // Public can read only individually published invoices by opaque id.
      allow get: if isAdmin() || resource.data.published == true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'holder','account','bank','amount','memo',
          'published','createdAt','createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.holder is string
        && request.resource.data.account is string
        && request.resource.data.bank is string
        && request.resource.data.memo is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update, delete: if isAdmin();
    }
    match /{other=**} { allow read, write: if false; }
  }
}
